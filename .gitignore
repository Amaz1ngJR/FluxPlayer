# Xmake build files
.xmake/
build/
.cache/

# CMake build files
*.cmake

# Compiled files
*.o
*.a
*.so
*.dylib
*.dll
*.exe

# 离线超分固定版本运行库；只允许经过来源/散列核对的发行文件。
!source/onnxruntime/macos-arm64/libonnxruntime.1.23.2.dylib
!source/onnxruntime/windows-x64/onnxruntime.dll
!source/onnxruntime/windows-x64/onnxruntime_providers_shared.dll
!source/onnxruntime/windows-x64/DirectML.dll

# Allow FFmpeg prebuilt binaries
!third_party/ffmpeg/bin/*.dll
!third_party/ffmpeg/lib/*.lib
!third_party/ffmpeg-macos/lib/*.dylib

# Allow yt-dlp prebuilt binaries
!third_party/yt-dlp/yt-dlp_macos
!third_party/yt-dlp/yt-dlp.exe

# Allow WebView2 Loader (from Microsoft.Web.WebView2 NuGet redistributable)
!third_party/webview2/runtimes/win-x64/WebView2Loader.dll

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# macOS
.DS_Store
*.dSYM

# Log files
*.log

# Temporary files
*.tmp
*.temp

# Binary output
*.out

# Packaging output
dist/
*.dmg
