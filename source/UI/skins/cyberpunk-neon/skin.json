{
  "schemaVersion": 1,
  "id": "cyberpunk-neon",
  "name": "Cyberpunk Neon",
  "version": "1.0.0",
  "author": "FluxPlayer",
  "description": "Default neon drive console with cyan, violet and magenta HUD accents.",
  "compatibility": {
    "skinApi": 1,
    "surfaces": ["home", "opening", "player", "hud", "settings"]
  },
  "roles": {
    "background": {
      "void": "#030511",
      "canvas": "#050816",
      "panel": "#070D22",
      "panelRaised": "#0A1230",
      "panelTransparent": "rgba(7, 13, 34, 0.88)"
    },
    "accent": {
      "primary": "#00E8FF",
      "primarySoft": "#2DA7FF",
      "primaryDim": "#136C8F",
      "secondary": "#A855FF",
      "tertiary": "#FF3DF2"
    },
    "text": {
      "primary": "#EAF8FF",
      "secondary": "#A8C7E8",
      "muted": "#6F89A8",
      "disabled": "#3E526C"
    },
    "state": {
      "recording": "#FF3B7A",
      "warning": "#FFB84D",
      "error": "#FF3B7A",
      "success": "#00E8FF"
    },
    "line": {
      "subtle": "rgba(90, 140, 190, 0.22)",
      "primary": "rgba(0, 232, 255, 0.68)",
      "secondary": "rgba(168, 85, 255, 0.62)"
    }
  },
  "gradients": {
    "primaryRail": ["#00E8FF", "#2DA7FF", "#A855FF", "#FF3DF2"],
    "dockEdge": ["rgba(0, 232, 255, 0)", "#00E8FF", "#A855FF", "rgba(255, 61, 242, 0)"],
    "panelHeader": ["rgba(0, 232, 255, 0)", "rgba(0, 232, 255, 0.80)", "rgba(168, 85, 255, 0.80)", "rgba(255, 61, 242, 0)"]
  },
  "metrics": {
    "radius": {
      "panel": 6,
      "popup": 4,
      "button": 3,
      "progress": 2,
      "chip": 3
    },
    "spacing": {
      "screenMargin": 18,
      "dockPaddingX": 14,
      "dockPaddingY": 8,
      "panelPadding": 18,
      "controlGap": 8,
      "rowGap": 4
    },
    "size": {
      "bottomDockHeight": 82,
      "topRailHeight": 32,
      "hudPanelWidth": 340,
      "progressHotHeight": 18,
      "progressVisualHeight": 10,
      "mainPlayButton": [84, 30],
      "iconButton": [30, 30],
      "chipButton": [64, 30],
      "homeSourceCard": [570, 200],
      "homeCoreDiameter": 244,
      "openingPanel": [560, 398]
    },
    "opacity": {
      "dock": 0.78,
      "hudPanel": 0.88,
      "popup": 0.96,
      "subtleDecoration": 0.22,
      "disabled": 0.35
    }
  },
  "motion": {
    "autoHideDelaySeconds": 3.0,
    "volumeCloseDelaySeconds": 0.4,
    "scanlineSpeed": 30,
    "pulseSpeed": 2.6,
    "hoverGlowMs": 120,
    "reloadDebounceMs": 160
  },
  "typography": {
    "displayFamily": "ShareTechMono-Regular.ttf",
    "bodyFamily": "ImGui default or system CJK font",
    "titlePx": 38,
    "panelTitlePx": 13,
    "bodyPx": 13,
    "timecodePx": 13,
    "buttonPx": 12
  },
  "decoration": {
    "cutCorners": true,
    "glow": true,
    "scanlines": true,
    "circuitTicks": true,
    "homeCore": true
  },
  "assets": {
    "preview": "preview.svg"
  }
}
