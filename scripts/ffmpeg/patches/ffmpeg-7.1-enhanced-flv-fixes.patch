FFmpeg 7 Enhanced FLV regression fixes (not a backport of the 4.4 parser).
Base: pinned 5a1f107b4c after legacy-hevc and private-flv patches.
Preserve upstream framing; reject truncated headers, skip unknown FourCC/EOS before stream creation,
and submit av1C configOBUs for keyframes. Upstream license: LGPL-2.1-or-later.

--- a/libavformat/flvdec.c
+++ b/libavformat/flvdec.c
@@ -1270,8 +1270,20 @@
         enhanced_flv = (flags >> 7) & 1;
         size--;
         if (enhanced_flv) {
+            int packet_type = flags & 0x0F;
+            if (size < 4)
+                return AVERROR_INVALIDDATA;
             video_codec_id = avio_rb32(s->pb);
             size -= 4;
+            if (video_codec_id != MKBETAG('h', 'v', 'c', '1') &&
+                video_codec_id != MKBETAG('a', 'v', '0', '1') &&
+                video_codec_id != MKBETAG('v', 'p', '0', '9'))
+                goto skip;
+            if (packet_type == PacketTypeSequenceEnd)
+                goto skip;
+            if (packet_type == PacketTypeCodedFrames &&
+                video_codec_id == MKBETAG('h', 'v', 'c', '1') && size < 3)
+                return AVERROR_INVALIDDATA;
         }
 
         if (enhanced_flv && stream_type == FLV_STREAM_TYPE_VIDEO && (flags & FLV_VIDEO_FRAMETYPE_MASK) == FLV_FRAME_VIDEO_INFO_CMD) {
@@ -1542,6 +1554,26 @@
     ret = av_get_packet(s->pb, pkt, size);
     if (ret < 0)
         return ret;
+    /* libdav1d parses av1C for dimensions but does not submit its configOBUs.
+     * Feed the current sequence header before keyframes, including a queued update. */
+    if (st->codecpar->codec_id == AV_CODEC_ID_AV1 &&
+        (flags & FLV_VIDEO_FRAMETYPE_MASK) == FLV_FRAME_KEY) {
+        const uint8_t *config = flv->new_extradata[stream_type] ?
+            flv->new_extradata[stream_type] : st->codecpar->extradata;
+        int config_size = flv->new_extradata[stream_type] ?
+            flv->new_extradata_size[stream_type] : st->codecpar->extradata_size;
+        if (config && config_size > 4 && config[0] == 0x81) {
+            int packet_size = pkt->size;
+            int err = av_grow_packet(pkt, config_size - 4);
+            if (err < 0) {
+                av_packet_unref(pkt);
+                return err;
+            }
+            memmove(pkt->data + config_size - 4, pkt->data, packet_size);
+            memcpy(pkt->data, config + 4, config_size - 4);
+            ret = pkt->size;
+        }
+    }
     pkt->dts          = dts;
     pkt->pts          = pts == AV_NOPTS_VALUE ? dts : pts;
     pkt->stream_index = st->index;
